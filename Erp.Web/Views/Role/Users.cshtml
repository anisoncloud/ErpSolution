@{
}
@model List<Erp.Core.Identity.ApplicationUser>
<h2>Users</h2>
<table class="table">
    <thead>
        <tr><th>Name</th><th>Email</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.FullName</td>
                <td>@user.Email</td>
                <td>
                    <a asp-action="AssignRole" asp-route-userId="@user.Id" class="btn btn-sm btn-primary">
                        Assign Roles
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>