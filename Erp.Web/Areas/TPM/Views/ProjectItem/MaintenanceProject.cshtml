@model IEnumerable<Erp.Modules.TPM.DTOs.ProjectMaintenanceDto>
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = "_Layout";
}
<h1>Projects under Maintenance</h1>
<a asp-action="Create">Project Create</a>
<table class="table table-striped">
    <thead>
        <tr>
            <th>No</th>
            <th>Project Name</th>
            <th>Start Date</th>
            <th>Live Date</th>
            <th>Value</th>
            
        </tr>
    </thead>
    @{
        var i = 1;
    }
    <tbody>
        @foreach (var project in Model)
        {
            <tr>
                <td>@i</td>
                <td>@project.Name</td>                
                <td>@project.MaintStartDate?.ToString("dd MMM yyyy")</td>
                <td>@project.LiveServerDate?.ToString("dd MMM yyyy")</td>
                <td>@project.MaintVale</td>
            </tr>
            i++;
        }
    </tbody>    
</table>