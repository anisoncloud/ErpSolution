@model Erp.Modules.TPM.DTOs.ProjectDashboardDto
@{
    Layout = "_Layout";
}
<div class="container mt-4">
    <!-- Project Header Section -->
    <div class="p-5 mb-4 bg-light rounded-3 shadow-sm border">
        <div class="container-fluid py-2">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
                <div>
                    <h1 class="display-5 fw-bold text-dark">📁 @Model.Name</h1>
                    <p class="col-md-12 fs-5 text-muted mb-0"></p>
                </div>
                <div>
                    <!-- Visual Anchor Button to trigger Modal Form -->
                    <button type="button" class="btn btn-primary btn-lg shadow-sm" data-bs-toggle="modal" data-bs-target="#createTaskModal">
                        ➕ Log New Task
                    </button>
                </div>
            </div>
        </div>
    </div>

    <h3 class="mb-4 text-secondary">Task Operational Logs (@Model.TasksDetails.Count)</h3>

    <!-- Task Logs Table Grid -->
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 30%">Task Title</th>
                        <th style="width: 20%">Current Lifecycle Position</th>
                        <th style="width: 15%">Logged Date</th>
                        <th style="width: 15%">Target Date</th>
                        <th style="width: 10%" class="text-center">Feedback Loops</th>
                        <th style="width: 10%" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.TasksDetails.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted fs-5">
                                No active tasks logged for this project yet. Click "Log New Task" to begin your backlog.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var task in Model.TasksDetails.OrderByDescending(t => t.CreatedAt))
                        {
                            <tr>
                                <td>
                                    <span class="fw-bold d-block text-primary">@task.Title</span>
                                    <small class="text-muted text-truncate d-inline-block" style="max-width: 300px;">@task.Description</small>
                                </td>
                                <td>
                                    <!-- Dynamic Badge Status Styling Context -->
                                    @switch (task.Status)
                                    {
                                        case "Backlog":
                                            <span class="badge bg-secondary p-2">📋 Backlog</span>
                                            ; break;
                                        case "InDevelopment":

                                            <span class="badge bg-warning text-dark p-2">⚡ In Development</span>
                                            ; break;
                                        case "ReadyForReview":

                                            <span class="badge bg-info text-white p-2">📤 Ready for Review</span>
                                            ; break;
                                        case "ClientFeedback":

                                            <span class="badge bg-danger p-2">🚩 Client Feedback</span>
                                            ; break;
                                        case "Completed":

                                            <span class="badge bg-success p-2">✅ Completed</span>
                                            ; break;
                                        default:

                                            <span class="badge bg-dark p-2">@task.Status</span>
                                            ; break;
                                    }
                                </td>
                                <td>@task.CreatedAt.ToString("dd MMM yyyy")</td>
                                <td>@(task.TargetDate?.ToString("dd MMM yyyy") ?? "No Deadline")</td>
                                <td class="text-center">
                                    <span class="badge rounded-pill bg-light text-dark border">
                                        @task.Revisions.Count rounds
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a asp-controller="ProjectTasks" asp-action="Details" asp-route-id="@task.Id" class="btn btn-sm btn-outline-dark shadow-sm">
                                        Manage Workflow →
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ==================== RAZOR FORM MODAL MARKUP ==================== -->
<div class="modal fade" id="createTaskModal" tabindex="-1" aria-labelledby="createTaskModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title" id="createTaskModalLabel">📋 Create Backlog Item & Log Task</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-controller="ProjectTasks" asp-action="CreateTask" method="post">
                <div class="modal-body p-4">
                    <!-- Hidden Foreign Key Property referencing the parent Project -->
                    <input type="hidden" name="ProjectId" value="@Model.Id" />

                    <!-- Form Item: Title -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Task Title</label>
                        <input type="text" name="Title" class="form-control form-control-lg border-2" placeholder="e.g., Create User Authentication Service" required />
                    </div>

                    <!-- Form Item: Description -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Task Requirements / Description</label>
                        <textarea name="Description" class="form-control border-2" rows="4" placeholder="Detail the specific user stories or features requested by the client..." required></textarea>
                    </div>

                    <!-- Form Item: Target Date -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Target / Expected Completion Date (Optional)</label>
                        <input type="date" name="TargetDate" class="form-control border-2" min="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
                    </div>
                </div>

                <div class="modal-footer bg-light p-3">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success px-4 shadow-sm">🚀 Push to Backlog</button>
                </div>
            </form>
        </div>
    </div>
</div>
