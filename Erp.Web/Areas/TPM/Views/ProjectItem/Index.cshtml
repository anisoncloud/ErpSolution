@model IEnumerable<Erp.Modules.TPM.DTOs.ProjectItemDto>
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = "_Layout";
}
<h1>Project</h1>
<a asp-action="Create">Project Create</a>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Project Name</th>
            <th>WODate</th>
            <th>Value</th>
            <th>Advanced </th>
            <th>Due Payment</th>
            <th>Days</th>
            <th>DeliveryDate</th>
            <th>Proposal</th>
            <th>Work Order</th>
            <th>What to do</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var project in Model)
        {
            <tr>
                <td>@project.Name</td>
                @* <td>@project.PeopleProjects.Count()</td>
                <td>
                    @foreach (var people in project.PeopleProjects)
                    {
                        @people.People.Name
                        ;
                    }
                </td> *@
                <td>@project.WorkOrderDate?.ToString("dd MMM yyyy")</td>
                <td>@project.ProjectValue</td>
                <td>@project.Advanced</td>
                <td>@project.DuePayment</td>
                <td>@project.ProjectDays</td>
                <td>@project.ProjectDeliveryDate?.ToString("dd MMM yyyy")</td>
                <td><a target="_blank" href="@project.Proposal">Proposal</a></td>
                <td><a target="_blank" href="@project.WorkOrder">Work Order</a></td>
                <td><a target="_blank" href="@project.SoftwareRequirement">Requirement</a></td>
                <td>Status</td>
                <td>
                    <a class="btn btn-warning btn-sm p-1" asp-action="PeopleAssign" asp-route-id="">Edit</a>
                    <a class="btn btn-primary btn-sm p-1" asp-action="PeopleAssign" asp-route-id="">Details</a>
                    <a class="btn btn-danger btn-sm p-1" asp-action="PeopleAssign" asp-route-id="">Devs</a>
                </td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <th>Project Name</th>
            <th>WODate</th>
            <th>@Model.Sum(p => p.ProjectValue)</th>
            <th>@Model.Sum(p => p.Advanced) </th>
            <th>@Model.Sum(p => p.DuePayment)</th>
            <th>Days</th>
            <th>DeliveryDate</th>
            <th>Proposal</th>
            <th>Work Order</th>
            <th>What to do</th>
            <th>Status</th>      
            <th>Action</th>      

        </tr>
    </tfoot>
</table>