@model IEnumerable<Erp.Modules.TPM.DTOs.ProjectItemDto>
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = "_Layout";
}
<h1>Project</h1>
<a asp-action="Create">Project Create</a>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Project Name</th>
            <th>Persons</th>
            <th>Developer</th>
            <th>Order Date</th>
            <th>Value</th>
            <th>Adv</th>
            <th>Due</th>
            <th>Days</th>
            <th>Delivery</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var project in Model)
        {
            <tr>
                <td>@project.Name</td>
                @* <td>@project.PeopleProjects.Count()</td>
                <td>
                    @foreach (var people in project.PeopleProjects)
                    {
                        @people.People.Name
                        ;
                    }
                </td> *@
                <td>@project.WorkOrderDate?.ToString("dd MMM yyyy")</td>
                <td>@project.ProjectValue</td>
                <td>@project.Advanced</td>
                <td>@project.DuePayment</td>
                <td>@project.ProjectDays</td>
                <td>@project.ProjectDeliveryDate?.ToString("dd MMM yyyy")</td>
                @* <td>
                    <a asp-action="PeopleAssign" asp-route-id="@project.Id">Project Assign</a>
                </td> *@
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <th>Project Name</th>
            <th>Persons</th>
            <th>Developer</th>
            <th>Order Date</th>
            <th>@Model.Sum(p => p.ProjectValue)</th>
            <th>Adv</th>
            <th>Due</th>
            <th>Days</th>
            <th>Delivery</th>
            <th>Action</th>

        </tr>
    </tfoot>
</table>