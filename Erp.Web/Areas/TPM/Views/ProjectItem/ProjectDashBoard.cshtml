@model List<Erp.Modules.TPM.DTOs.ProjectDashboardDto>
@{
    Layout = "_Layout";
}
<div class="container mt-4">
    <!-- Dashboard Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-5 pb-3 border-bottom flex-wrap gap-3">
        <div>
            <h1 class="fw-bold text-dark mb-1">🚀 Project Portfolio Management</h1>
            <p class="text-muted mb-0">Track project scopes, client workflows, and backlog states across all workspaces.</p>
        </div>
        <div>
            <!-- Main navigation to initialize a brand new project -->
            <a asp-action="Create" class="btn btn-success btn-lg shadow-sm font-weight-bold">
                ✨ Initialize New Project
            </a>
        </div>
    </div>

    <!-- Empty State for the Entire Application Workspace -->
    @if (!Model.Any())
    {
        <div class="card text-center shadow-sm p-5 border-2 border-dashed bg-light my-5">
            <div class="card-body py-5">
                <div class="fs-1 text-muted mb-3">📁</div>
                <h3 class="fw-bold text-secondary">No Active Workspaces Found</h3>
                <p class="text-muted max-width-500 mx-auto mb-4">
                    Get started by initializing your first development project workspace. Once created, you can instantly track client backlogs.
                </p>
                <a asp-action="Create" class="btn btn-primary px-4 shadow-sm">
                    Create Your First Project
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- Project Portfolio Grid Layout -->
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var project in Model.OrderByDescending(p => p.Id))
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 rounded-3 transition-hover">
                        <div class="card-body d-flex flex-column p-4">

                            <!-- Card Info Details -->
                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-start">
                                    <h4 class="card-title fw-bold text-dark text-truncate mb-1" style="max-width: 80%;">
                                        @project.Name
                                    </h4>
                                    <span class="badge bg-dark rounded-pill">
                                        @project.TasksDetails.Count Items
                                    </span>
                                </div>
                                <p class="card-text text-muted text-break small mt-2" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                                    
                                </p>
                            </div>

                            <hr class="mt-auto mb-3 text-muted" />

                            <!-- Dynamic Context-Driven Backlog Blocks -->
                            <div class="mb-4 flex-grow-1">
                                @if (project.TasksDetails.Any())
                                {
                                    <h6 class="text-uppercase fw-bold text-secondary small mb-2">📋 Active Backlog Items</h6>
                                    <ul class="list-group list-group-flush border rounded overflow-hidden">
                                        @foreach (var task in project.TasksDetails.Take(3)) // Preview up to 3 tasks to keep layout neat
                                        {
                                            <li class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2 bg-light">
                                                <span class="small text-truncate fw-medium text-dark" style="max-width: 70%;">
                                                    @task.Title
                                                </span>
                                                <!-- Tiny Contextual Badges for Quick Scanning -->
                                                @switch (task.Status)
                                                {
                                                    case "Backlog":
                                                        <span class="badge bg-secondary style-mini text-xxs">Backlog</span>
                                                        ; break;
                                                    case "InDevelopment":

                                                        <span class="badge bg-warning text-dark style-mini text-xxs">Dev</span>
                                                        ; break;
                                                    case "ReadyForReview":

                                                        <span class="badge bg-info text-white style-mini text-xxs">Review</span>
                                                        ; break;
                                                    case "ClientFeedback":

                                                        <span class="badge bg-danger style-mini text-xxs">Feedback</span>
                                                        ; break;
                                                    case "Completed":

                                                        <span class="badge bg-success style-mini text-xxs">Done</span>
                                                        ; break;
                                                }
                                            </li>
                                        }
                                    </ul>
                                    @if (project.TasksDetails.Count > 3)
                                    {
                                        <small class="text-muted d-block text-end mt-1 italic">
                                            + @(project.TasksDetails.Count - 3) more items in queue...
                                        </small>
                                    }
                                }
                                else
                                {
                                    <!-- Fallback: Renders a friendly warning message and direct button if empty -->
                                    <div class="alert alert-warning py-3 mb-0 text-center rounded d-flex flex-column align-items-center border-0 shadow-none">
                                        <span class="small text-warning-emphasis mb-2 d-block">⚠️ No logs or backlog records found.</span>
                                        <a asp-action="CreateBacklog" class="btn btn-sm btn-warning shadow-sm font-weight-bold w-100">
                                            ➕ Create Backlog Entry
                                        </a>
                                    </div>
                                }
                            </div>

                            <!-- Primary View Action Button -->
                            <div>
                                <a asp-action="TaskLogs" asp-route-id="@project.Id" class="btn btn-outline-primary w-100 fw-bold shadow-sm">
                                    📁 View Complete Backlogs →
                                </a>
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Extra Micro Styling for Dashboard Sub-Elements -->
<style>
    .transition-hover {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .transition-hover:hover {
            transform: translateY(-4px);
            box-shadow: 0 .5rem 1.5rem rgba(0,0,0,.08) !important;
        }

    .style-mini {
        padding: 0.25em 0.5em;
        font-size: 0.7rem;
    }

    .text-xxs {
        font-size: 0.65rem;
    }
</style>
