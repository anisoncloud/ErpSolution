@model Erp.Modules.TPM.DTOs.ProjectItemCreateDto
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@{
    Layout = "_Layout";
}
<h1>Create Project</h1>
<hr />
<form asp-action="Create" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-bg-danger"></div>
    <div class="mb-3">
        <label for="exampleFormControlInput1" class="form-label">Company</label>
        <input asp-for="Name" type="text" class="form-control" id="exampleFormControlInput1" placeholder="Company will be goes in here">
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label for="exampleFormControlInput1" class="form-label">Company Code</label>
        <input asp-for="WorkOrderDate" type="date" class="form-control" id="exampleFormControlInput1" placeholder="Company Code be goes in here">
        <span asp-validation-for="WorkOrderDate" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label for="exampleFormControlInput1" class="form-label">Company Code</label>
        <input asp-for="DemoStartDate" type="date" class="form-control" id="exampleFormControlInput1" placeholder="Company Code be goes in here">
        <span asp-validation-for="DemoStartDate" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label for="exampleFormControlInput1" class="form-label">Company Code</label>
        <input asp-for="ProjectDeliveryDate" type="date" class="form-control" id="exampleFormControlInput1" placeholder="Company Code be goes in here">
        <span asp-validation-for="ProjectDeliveryDate" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label for="exampleFormControlInput1" class="form-label">Company Code</label>
        <input asp-for="ProjectValue" type="number" class="form-control" id="exampleFormControlInput1" placeholder="Company Code be goes in here">
        <span asp-validation-for="ProjectValue" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label for="exampleFormControlInput1" class="form-label">Company Code</label>
        <input asp-for="Advanced" type="number" class="form-control" id="exampleFormControlInput1" placeholder="Company Code be goes in here">
        <span asp-validation-for="Advanced" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label for="exampleFormControlInput1" class="form-label">Company Code</label>
        <input asp-for="ProjectDays" type="number" class="form-control" id="exampleFormControlInput1" placeholder="Company Code be goes in here">
        <span asp-validation-for="ProjectDays" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label for="exampleFormControlInput1" class="form-label">Company Code</label>
        <input asp-for="Proposal" type="file" class="form-control" id="exampleFormControlInput1" placeholder="Company Code be goes in here">
        <span asp-validation-for="Proposal" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label for="exampleFormControlInput1" class="form-label">Company Code</label>
        <input asp-for="WorkOrder" type="file" class="form-control" id="exampleFormControlInput1" placeholder="Company Code be goes in here">
        <span asp-validation-for="WorkOrder" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label for="exampleFormControlInput1" class="form-label">Company Code</label>
        <input asp-for="SoftwareRequirement" type="file" class="form-control" id="exampleFormControlInput1" placeholder="Company Code be goes in here">
        <span asp-validation-for="SoftwareRequirement" class="text-danger small"></span>
    </div>
    
    <button type="submit" class="btn btn-primary">Create Project</button>
</form>