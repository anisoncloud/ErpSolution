@model Erp.Web.Areas.HRM.Models.LeaveApprovalsViewModel
@using Erp.Modules.HRM.Entities
@{
    Layout = "_Layout";
    ViewData["Title"] = "Leave Approvals";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center">
        <h3>Pending Leave Applications</h3>
        <a asp-controller="Compensation" asp-action="Index" class="btn btn-outline-primary">Set Compensation leave</a>
    </div>

    @if (TempData["Success"] is string ok) { <div class="alert alert-success mt-3">@ok</div> }
    @if (TempData["Error"] is string err) { <div class="alert alert-danger mt-3">@err</div> }

    @if (!Model.Items.Any())
    {
        <p class="text-muted mt-3">Nothing is waiting for your approval.</p>
    }
    else
    {
        <form asp-area="HRM" asp-controller="Leave" asp-action="Approvals" method="post" class="mt-3">
            @Html.AntiForgeryToken()
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th style="width:40px"></th>
                        <th>Employee</th><th>Type</th><th>From</th><th>Return</th><th>Days</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var i in Model.Items)
                {
                    <tr>
                        <td><input type="checkbox" name="selectedIds" value="@i.Id" checked /></td>
                        <td>@i.EmployeeName</td>
                        <td>@i.Type.ToString()</td>
                        <td>@i.From.ToString("ddd, dd MMM yyyy")</td>
                        <td>@i.Return.ToString("ddd, dd MMM yyyy")</td>
                        <td>@i.Days</td>
                    </tr>
                }
                </tbody>
            </table>

            <div class="mb-3" style="max-width:600px">
                <label for="comment" class="form-label">Comment <span class="text-muted">(required to decline)</span></label>
                <textarea id="comment" name="comment" class="form-control" rows="2" maxlength="1000"></textarea>
            </div>

            <button type="submit" name="decision" value="approve" class="btn btn-success">Approve</button>
            <button type="submit" name="decision" value="decline" class="btn btn-danger">Decline</button>
        </form>
    }
</div>
