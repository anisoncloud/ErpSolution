@model Erp.Web.Areas.HRM.Models.LeaveApprovalsViewModel
@using Erp.Modules.HRM.Entities
@{
    Layout = "_Layout";
    ViewData["Title"] = "Leave Approvals";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center">
        <h3>Pending Leave Applications</h3>
        <a asp-controller="Compensation" asp-action="Index" class="btn btn-outline-primary">Set Compensation leave</a>
    </div>

    @if (TempData["Success"] is string ok)
    {
        <div class="alert alert-success mt-3">@ok</div>
    }
    @if (TempData["Error"] is string err)
    {
        <div class="alert alert-danger mt-3">@err</div>
    }

    @if (!Model.Items.Any())
    {
        <p class="text-muted mt-3">Nothing is waiting for your approval.</p>
    }
    else
    {
        <form asp-area="HRM" asp-controller="Leave" asp-action="Approvals" method="post" class="mt-3" id="approvalForm">
            @Html.AntiForgeryToken()

            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th style="width:40px"></th>
                        <th>Employee name</th>
                        <th>Leave type</th>
                        <th>From date</th>
                        <th>To date</th>
                        <th class="text-end">Days</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in Model.Items)
                    {
                        <tr>
                            <td><input type="checkbox" name="selectedIds" value="@i.Id" class="row-check" checked /></td>
                            <td>@i.EmployeeName</td>
                            <td>@i.Type.ToString()</td>
                            <td>@i.From.ToString("ddd, dd MMM yyyy")</td>
                            @* To date is the last day of leave: the return date is the first day back at work. *@
                            <td>@i.Return.AddDays(-1).ToString("ddd, dd MMM yyyy")</td>
                            <td class="text-end">@i.Days</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="row g-2 align-items-start" style="max-width: 720px;">
                <div class="col-sm-4">
                    <label for="decision" class="form-label">Action</label>
                    <select id="decision" name="decision" class="form-select">
                        <option value="approve">Approved</option>
                        <option value="decline">Decline</option>
                    </select>
                </div>
                <div class="col-sm-8">
                    <label for="comment" class="form-label">
                        Comment <span class="text-muted" id="commentHint">(optional)</span>
                    </label>
                    <textarea id="comment" name="comment" class="form-control" rows="1" maxlength="1000"></textarea>
                </div>
            </div>

            <div class="text-danger small mt-2" id="formError" role="alert"></div>
            <button type="submit" class="btn btn-primary mt-2">Submit</button>
        </form>
    }
</div>

@section Scripts {
    <script>
        (function () {
            const form = document.getElementById('approvalForm');
            if (!form) return;
            const decision = document.getElementById('decision');
            const comment = document.getElementById('comment');
            const hint = document.getElementById('commentHint');
            const error = document.getElementById('formError');

            function syncHint() {
                const decline = decision.value === 'decline';
                hint.textContent = decline ? '(required to decline)' : '(optional)';
                comment.required = decline;
            }
            decision.addEventListener('change', syncHint);
            syncHint();

            // The server checks all of this again; this only saves a round trip.
            form.addEventListener('submit', function (e) {
                error.textContent = '';
                if (!form.querySelector('.row-check:checked')) {
                    e.preventDefault();
                    error.textContent = 'Select at least one application.';
                    return;
                }
                if (decision.value === 'decline' && !comment.value.trim()) {
                    e.preventDefault();
                    error.textContent = 'A comment is required to decline.';
                }
            });
        })();
    </script>
}
