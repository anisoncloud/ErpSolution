@model IEnumerable<Erp.Modules.HRM.DTOs.DesignationDto>
@{
    Layout = "_Layout";
}
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

<div class="d-flex">
    <h5> All Designation</h5>
    <a class="btn btn-primary ms-auto" asp-action="Create" asp-area="hrm">Create</a>
</div>
<hr />

@if (TempData["success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["success"]
        <button type="button" class="btn-close"
                data-bs-dismiss="alert"></button>
    </div>
}
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col">Designation Name</th>
            <th scope="col">Designation Code</th>
            <th scope="col">Description</th>
            <th scope="col">Status</th>
            <th scope="col">Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <th scope="row">1</th>
                <td>@item.Title</td>
                <td>@item.DesignationCode</td>
                <td>@item.Description</td>
                <td>@(item.IsActive ? "Active" : "In Active")</td>
                <td><a class="btn btn-warning btn-sm p-1" asp-action="Edit" asp-route-id="@item.Id">Edit</a></td>
            </tr>
        }
    </tbody>
</table>