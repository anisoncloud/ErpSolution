@using Erp.Modules.HRM.Enums
@model Erp.Modules.HRM.ViewModels.EmployeeFormViewModel
@{
    Layout = "_Layout";
}
<h2>Create Employee</h2>

<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label>Company</label>
        <select asp-for="CompanyId" class="form-control"
                asp-items="@(new SelectList(ViewBag.Companies, "Id", "Name"))">
            <option value="">-- Select Company --</option>
        </select>
    </div>
    <div class="mb-3">
        <label>Department</label>
        <select asp-for="DepartmentId" class="form-control"
                asp-items="@(new SelectList(ViewBag.Departments, "Id", "Name"))">
            <option value="">-- Select Department --</option>
        </select>
    </div>
    <div class="mb-3">
        <label>Designation</label>
        <select asp-for="DesignationId" class="form-control"
                asp-items="@(new SelectList(ViewBag.Designations, "Id", "Title"))">
            <option value="">-- Select Designation --</option>
        </select>
    </div>
    <div class="mb-3"><label>Employee Code</label><input asp-for="EmployeeCode" class="form-control" /></div>
    <div class="mb-3"><label>Full Name</label><input asp-for="FullName" class="form-control" /></div>
    
    <div class="form-group">
        <label asp-for="EmployeeType" class="control-label"></label>
        <select asp-for="EmployeeType" asp-items="Html.GetEnumSelectList<EmployeeType>()" class="form-control">
            <option value="">-- Select Type --</option>
        </select>
    </div>
    <div class="form-group">
        <label asp-for="DutyType" class="control-label"></label>
        <select asp-for="DutyType" asp-items="Html.GetEnumSelectList<DutyType>()" class="form-control">
            <option value="">-- Select Duty Type --</option>
        </select>
    </div>
    <div class="mb-3"><label>Email</label><input asp-for="Email" class="form-control" /></div>
    <div class="mb-3"><label>Phone</label><input asp-for="Phone" class="form-control" /></div>
    

    <div class="mb-3">
        <label>Level (drives access role)</label>
        <select asp-for="Level" class="form-control"
                asp-items="Html.GetEnumSelectList<Erp.Modules.HRM.Enums.EmployeeLevel>()"></select>
    </div>

    <div class="mb-3"><label>Joining Date</label><input asp-for="JoiningDate" class="form-control" type="date" /></div>
    <div class="mb-3"><label>Salary</label><input asp-for="Salary" class="form-control" /></div>
    <div class="mb-3"><label>Temporary Password</label><input asp-for="TemporaryPassword" class="form-control" /></div>

    <button type="submit" class="btn btn-primary">Create Employee</button>
</form>