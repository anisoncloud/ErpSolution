@using Erp.Modules.HRM.Enums
@model Erp.Modules.HRM.ViewModels.EmployeeFormViewModel
@{
    Layout = "_Layout";
}
<h2>Create Employee</h2>

<form asp-action="Create" method="post">
    <div class="row">
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="col">
            <div class="mb-3">
                <label>Company</label>
                <select asp-for="CompanyId" class="form-control"
                        asp-items="@(new SelectList(ViewBag.Companies, "Id", "Name"))">
                    <option value="">-- Select Company --</option>
                </select>
            </div>
            <div class="mb-3">
                <label>Department</label>
                <select asp-for="DepartmentId" class="form-control"
                        asp-items="@(new SelectList(ViewBag.Departments, "Id", "Name"))">
                    <option value="">-- Select Department --</option>
                </select>
            </div>
            <div class="mb-3">
                <label>Designation</label>
                <select asp-for="DesignationId" class="form-control"
                        asp-items="@(new SelectList(ViewBag.Designations, "Id", "Title"))">
                    <option value="">-- Select Designation --</option>
                </select>
            </div>
            <div class="mb-3">
                <label>Employee Code</label>
                <input asp-for="EmployeeCode" class="form-control" />
            </div>
            <div class="mb-3">
                <label>Full Name</label>
                <input asp-for="FullName" class="form-control" />
            </div>
            
        </div>
        <div class="col">
            <div class="mb-3">
                <label>Email</label>
                <input asp-for="Email" class="form-control" />
            </div>
            <div class="mb-3">
                <label>Phone</label>
                <input asp-for="Phone" class="form-control" />
            </div>   
            <div class="mb-3">
                <label asp-for="SelectedRole" class="control-label"></label>
                <select asp-for="SelectedRole" asp-items="Model.RolesList" class="form-select">
                    <option value="">-- Select User Role --</option>
                </select>
                <span asp-validation-for="SelectedRole" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="EmployeeType" class="control-label"></label>
                <select asp-for="EmployeeType" asp-items="Html.GetEnumSelectList<EmployeeType>()" class="form-control">
                    <option value="">-- Select Type --</option>
                </select>
            </div>
            <div class="mb-3">
                <div class="form-check mb-2">
                    <input type="checkbox" class="form-check-input" id="showAllDepts" />
                    <label class="form-check-label" for="showAllDepts">Show managers from all departments</label>
                </div>
                <label asp-for="EmpManagerId" class="control-label">Line Manager</label>
                <select asp-for="EmpManagerId" class="form-control">
                    <option value="">-- Select Manager --</option>
                </select>
                <small id="managerNote" class="text-muted"></small>
                <span asp-validation-for="EmpManagerId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ManagerEmail" class="control-label">Line Manager Email</label>
                <input asp-for="ManagerEmail" class="form-control" readonly />
            </div>
        </div>
        <div class="col">
            
            <div class="mb-3">
                <label asp-for="DutyType" class="control-label"></label>
                <select asp-for="DutyType" asp-items="Html.GetEnumSelectList<DutyType>()" class="form-control">
                    <option value="">-- Select Duty Type --</option>
                </select>
            </div>
            <div class="mb-3">
                <label>Level (drives access role)</label>
                <select asp-for="Level" class="form-control"
                        asp-items="Html.GetEnumSelectList<Erp.Modules.HRM.Enums.EmployeeLevel>()"></select>
            </div>
            <div class="mb-3">
                <label>Joining Date</label>
                <input asp-for="JoiningDate" class="form-control" type="date" />
            </div>
            <div class="mb-3">
                <label>Salary</label><input asp-for="Salary" class="form-control" />
                </div>
            <div class="mb-3">
                <label>Temporary Password</label>
                <input asp-for="TemporaryPassword" class="form-control" />
            </div>
            <button type="submit" class="btn btn-primary">Create Employee</button>
        </div>
        
    </div>
    
</form>
@section Scripts {
<script>
(function () {
    const deptSelect    = document.getElementById('DepartmentId');
    const managerSelect = document.getElementById('EmpManagerId');
    const managerEmail  = document.getElementById('ManagerEmail');
    const showAll       = document.getElementById('showAllDepts');
    const note          = document.getElementById('managerNote');
    const url           = '@Url.Action("GetManagerCandidates", "Employee")';
    const postedManager = '@Model.EmpManagerId';   // restores selection after a failed POST

    let headId = null;

    function reset() {
        managerSelect.innerHTML = '<option value="">-- Select Manager --</option>';
        managerEmail.value = '';
        note.textContent = '';
    }

    function updateInfo() {
        const opt = managerSelect.options[managerSelect.selectedIndex];
        managerEmail.value = opt?.dataset.email ?? '';

        if (!opt || !opt.value) { note.textContent = ''; return; }

        const isCross = deptSelect.value && opt.dataset.deptId !== deptSelect.value;
        note.textContent = isCross
            ? `Cross-department manager (${opt.dataset.dept}).`
            : (opt.value === String(headId) ? 'Department head selected by default.' : '');
    }

    async function loadManagers(preselect) {
        reset();
        if (!deptSelect.value && !showAll.checked) return;

        const qs = new URLSearchParams({ all: showAll.checked });
        if (deptSelect.value) qs.set('departmentId', deptSelect.value);

        const res = await fetch(`${url}?${qs}`);
        if (!res.ok) return;
        const data = await res.json();
        headId = data.headId;

        data.items.forEach(e => {
            const opt = document.createElement('option');
            opt.value = e.id;
            opt.textContent = showAll.checked ? `${e.name} (${e.department})` : e.name;
            opt.dataset.email  = e.email ?? '';
            opt.dataset.deptId = e.departmentId;
            opt.dataset.dept   = e.department;
            managerSelect.appendChild(opt);
        });

        // keep a posted value if still in the list, otherwise default to the head
        const wanted = preselect || (headId ? String(headId) : '');
        if (wanted && [...managerSelect.options].some(o => o.value === wanted))
            managerSelect.value = wanted;

        updateInfo();
    }

    deptSelect.addEventListener('change', () => loadManagers());
    showAll.addEventListener('change', () => loadManagers(managerSelect.value));
    managerSelect.addEventListener('change', updateInfo);

    // initial load / reload after validation failure
    if (deptSelect.value) loadManagers(postedManager);
})();
</script>
}