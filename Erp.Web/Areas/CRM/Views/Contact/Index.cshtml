@* @model IEnumerable<MyErp.Models.CrmContact> *@
@model IEnumerable<Erp.Modules.CRM.DTOs.CompanyDto>
@{
    Layout = "_Layout";
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@section Styles {
    <link href="https://cdn.datatables.net/2.3.4/css/dataTables.bootstrap5.css" rel="stylesheet" type="text/css" />
}
<h1 class="display-3">Contacts</h1> <a asp-action="Create" asp-controller="CrmContacts">Create</a>
<table id="example" class="table table-striped">
        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">Name</th>
                <th scope="col">Designation</th>
                <th scope="col">Contact</th>
                <th scope="col">Phone</th>
                              
            </tr>
        </thead>
        <tbody>
            @{
                var serial = 1;
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td scope="row">@serial</td>
                    <td>@item.Name</td>
                    <td>@foreach (var c in item.Contacts)
                {
                    <div>@c.Name — @c.Phone - @c.Email</div>
                }</td>
                    <td></td>
                    <td></td>                           
                </tr>
                serial++;
            }
        </tbody>
    </table>
@section Scripts {
    <script src="https://cdn.datatables.net/2.3.4/js/dataTables.js"></script>
    <script src="https://cdn.datatables.net/2.3.4/js/dataTables.bootstrap5.js"></script>
    <script>
        new DataTable('#example');
    </script>

}