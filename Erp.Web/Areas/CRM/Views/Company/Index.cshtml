@using Erp.Core.Pagination
@model PagedResult<Erp.Modules.CRM.DTOs.CompanyListItemDto>
@{
    Layout = "_Layout";
}
<h2>All Company</h2>
<a asp-action="Create" class="btn btn-primary mb-3">+ Create New </a>
<form method="get" class="d-flex gap-2 mb-3">
    <input type="text" name="searchTerm" value="@Model.SearchTerm"
           class="form-control" placeholder="Search employees..." />
    @* keep current sort when a new search is submitted *@
    <input type="hidden" name="sortColumn" value="@Model.SortColumn" />
    <input type="hidden" name="sortDirection" value="@Model.SortDirection" />
    <button type="submit" class="btn btn-primary">Search</button>
</form>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <sortable-th column="Name" display-text="Name"
                         current-sort-column="@Model.SortColumn"
                         current-sort-direction="@Model.SortDirection" />
            <sortable-th column="CompanyEmail" display-text="CompanyEmail"
                         current-sort-column="@Model.SortColumn"
                         current-sort-direction="@Model.SortDirection" />
            <sortable-th column="CompanyPhone" display-text="CompanyPhone"
                         current-sort-column="@Model.SortColumn"
                         current-sort-direction="@Model.SortDirection" />
            <sortable-th column="NormalizedName" display-text="NormalizedName"
                         current-sort-column="@Model.SortColumn"
                         current-sort-direction="@Model.SortDirection" />
        </tr>
    </thead>
    <tbody>
        @if (!Model.Items.Any())
        {
            <tr><td colspan="3" class="text-center">No employees found.</td></tr>
        }
        @foreach (var emp in Model.Items)
        {
            <tr>
                <td>@emp.Name</td>
                <td>@emp.CompanyEmail</td>
                <td>@emp.CompanyPhone</td>
                <td>@emp.NormalizedName</td>
            </tr>
        }
    </tbody>
</table>

<partial name="_Pagination" model="Model" />

<p class="text-muted">
    Showing page @Model.PageNumber of @Model.TotalPages (@Model.TotalCount total)
</p>
